# ─────────────────────────────────────────────────────────────────────────────
# Aaliqadr environment variables
#
# Every value starting with "dummy" is a PLACEHOLDER. The app runs locally with
# placeholders (catalogue from seed data, integrations disabled with a clear
# error), but a Vercel *production* deploy refuses to boot while any required
# value is still a placeholder. See src/env.ts and docs/03 §7.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database: MongoDB Atlas (cluster in ap-south-1 / Mumbai) ─────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aaliqadr?retryWrites=true&w=majority
MONGODB_URI=dummy-mongodb-uri

# ── Auth: Better Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dummy-better-auth-secret-change-me-32-bytes-min
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# ── Field encryption (DOB etc.): 32 random bytes, base64 ─────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=dummy-encryption-key-base64-32-bytes

# ── Payments: Razorpay (use rzp_test_* keys outside production) ──────────────
RAZORPAY_KEY_ID=dummy-razorpay-key-id
RAZORPAY_KEY_SECRET=dummy-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=dummy-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=dummy-razorpay-key-id

# ── Shipping: Shiprocket (API user, not the panel login) ─────────────────────
SHIPROCKET_EMAIL=dummy-shiprocket-api@example.com
SHIPROCKET_PASSWORD=dummy-shiprocket-password
SHIPROCKET_WEBHOOK_TOKEN=dummy-shiprocket-webhook-token
SHIPROCKET_PICKUP_LOCATION=dummy-pickup-location

# ── Storage: Vercel Blob (two stores: public media, private documents) ───────
BLOB_READ_WRITE_TOKEN=dummy-blob-public-token
BLOB_PRIVATE_READ_WRITE_TOKEN=dummy-blob-private-token

# ── Cache / rate limiting: Upstash Redis ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://dummy-upstash.example.com
UPSTASH_REDIS_REST_TOKEN=dummy-upstash-token

# ── Email: SMTP (OTP codes, order emails) ────────────────────────────────────
SMTP_HOST=dummy-smtp.example.com
SMTP_PORT=465
SMTP_USER=dummy-smtp-user
SMTP_PASS=dummy-smtp-password
# Gmail sends only from the SMTP_USER account (or a verified alias of it).
EMAIL_FROM="Aaliqadr <same-address-as-SMTP_USER@gmail.com>"
SUPPORT_EMAIL=care@example.com
# Becomes the store owner on first sign-in.
ADMIN_EMAIL=owner@example.com

# ── SMS / OTP: MSG91 (DLT-registered) ────────────────────────────────────────
MSG91_AUTH_KEY=dummy-msg91-auth-key
MSG91_OTP_TEMPLATE_ID=dummy-msg91-otp-template-id
MSG91_SENDER_ID=dummy-sender-id

# ── Cron (Vercel sends "Authorization: Bearer <CRON_SECRET>") ────────────────
CRON_SECRET=dummy-cron-secret

# ── Errors: Sentry (optional until launch) ───────────────────────────────────
SENTRY_DSN=dummy-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=dummy-sentry-dsn

# Optional: send email through Resend instead of SMTP (verify the brand domain first).
RESEND_API_KEY=
# Optional: incoming webhook (Slack/Discord/Google Chat) for operational alerts.
ALERT_WEBHOOK_URL=
