    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "sanitize-html": "^2.18.1",
